# Dependencies & build output (rebuilt inside the image)
node_modules
dist

# Git / IDE / local tooling
.git
.github
.agents
.artifacts
.codex
.deploy
.smoke-frontend
.ssh-askpass.tmp
.vscode
.idea
*.swp
*.swo
.DS_Store

# Env and secrets (never bake into the image)
.env
.env.*
!.env.example

# Tests, docs, fixtures (not needed at runtime)
test
docs
fixtures
scripts
*.md
!package.json

# Lint / typecheck / OpenAPI tooling inputs
eslint.config.mjs
redocly.yaml
tsconfig.test.json
*.tsbuildinfo
coverage
.nyc_output

# Logs
*.log
npm-debug.log*
