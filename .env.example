# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL (required outside tests)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/oilapi

# Redis (optional; cache + rate limit)
REDIS_URL=

# API key hashing pepper (required outside dev)
API_KEY_PEPPER=

# Artifact storage
ARTIFACT_STORAGE_MODE=local
ARTIFACT_LOCAL_DIR=./.artifacts

# S3 (required when ARTIFACT_STORAGE_MODE=s3)
S3_BUCKET=
S3_REGION=