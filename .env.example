# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL (required outside tests)
# Host Node + compose infra: localhost:55432
# Inside docker compose services: postgres:5432 (see compose.yaml)
DATABASE_URL=postgres://oilapi:oilapi@localhost:55432/oilapi

# Redis (optional; cache + rate limit)
# Host: localhost:56379 · Compose network: redis:6379
REDIS_URL=redis://localhost:56379

# API key hashing pepper (required outside dev)
API_KEY_PEPPER=dev-pepper

# Artifact storage
ARTIFACT_STORAGE_MODE=local
ARTIFACT_LOCAL_DIR=./.artifacts

# S3 (required when ARTIFACT_STORAGE_MODE=s3)
# Compose stack uses MinIO: S3_ENDPOINT=http://minio:9000 (in-network)
# or http://localhost:59000 from the host, with path-style + AWS_* = MinIO root.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=oil-api/artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ingestion / fetcher
INGESTION_LIVE_FETCH=false
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=5242880
INGESTION_USER_AGENT=OilAPI/0.1 local-development
