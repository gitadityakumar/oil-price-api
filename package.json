{
  "name": "oil-api",
  "version": "0.1.0",
  "description": "Indian Fuel Price API — native Node.js HTTP service.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/**/*.test.ts test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "npm run typecheck",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/migrate.ts --seed"
  },
  "dependencies": {
    "pg": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
