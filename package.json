{
  "name": "oil-api",
  "version": "0.1.0",
  "description": "Indian Fuel Price API — native Node.js HTTP service.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts test/*.test.ts",
    "test:db-smoke": "node --import tsx test/db-access.smoke.ts",
    "test:ci": "tsx src/cli/require-database.ts && npm test && npm run test:db-smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "openapi:lint": "redocly lint docs/openapi.yaml --format=stylish",
    "check": "npm run lint && npm run typecheck && npm run build && npm run openapi:lint && npm test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/migrate.ts --seed",
    "db:fixtures": "tsx src/db/migrate.ts --fixtures",
    "generate:coverage-fixtures": "tsx scripts/generate-coverage-fixtures.ts",
    "seed:pin-reference": "tsx scripts/seed-pin-reference.ts",
    "verify:pin-coverage": "tsx scripts/verify-pin-coverage.ts",
    "coverage:ingest": "npm run build && bash scripts/vm-ingest-coverage.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1084.0",
    "pg": "8.22.0",
    "redis": "5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.38.0",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "eslint": "10.6.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "yaml": "2.9.0"
  }
}
